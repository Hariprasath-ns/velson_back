generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  credentials   UserCredential?
  permissions   UserPermission[]
  refreshTokens RefreshToken[]
}

model UserCredential {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  username       String    @unique
  password       String
  role           String    @default("user")
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockoutUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPermission {
  id         Int      @id @default(autoincrement())
  userId     Int
  module     String   // e.g. "company-master"
  canDisplay Boolean  @default(false)
  canSave    Boolean  @default(false)
  canEdit    Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canPrint   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@map("user_permission")
}

model RolePermission {
  id         Int      @id @default(autoincrement())
  role       String   // e.g. "ACCOUNTS", "PURCHASE"
  module     String   // e.g. "company-master"
  canDisplay Boolean  @default(false)
  canSave    Boolean  @default(false)
  canEdit    Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canPrint   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, module])
  @@map("role_permission")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}


model ReferenceType {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String            @unique
  createdBy        String?
  createdAt        DateTime          @default(now())
  referenceMasters ReferenceMaster[]

  @@map("reference_type")
}

model ReferenceMaster {
  id                              Int               @id @default(autoincrement())
  referenceType                   String
  code                            String
  description                     String
  updatedBy                       String
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  referenceTypeId                 Int?
  purchaseRequestsByDept          PurchaseRequest[] @relation("PRDepartmentRef")
  purchaseRequestsByRequestingFor PurchaseRequest[] @relation("PRRequestingForRef")
  purchaseRequestsByTeam          PurchaseRequest[] @relation("PRTeamRef")
  refType                         ReferenceType?    @relation(fields: [referenceTypeId], references: [id])

  @@map("reference_master")
}

model TaxLedgerAccount {
  id         Int         @id @default(autoincrement())
  ledgerName String      @unique
  taxPercent Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  taxMasters TaxMaster[]

  @@map("tax_ledger_account")
}

model ItemGroupMaster {
  id        Int      @id @default(autoincrement())
  groupName String
  store     String
  prefix    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("item_group_master")
}

model Prefix {
  id         Int      @id @default(autoincrement())
  prefixCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("prefix")
}

model TaxMaster {
  id              Int              @id @default(autoincrement())
  taxLedgerId     Int
  taxPercent      Float
  cgstTax         Float
  sgstTax         Float
  igstTax         Float
  purchaseCgstTax Float
  purchaseSgstTax Float
  purchaseIgstTax Float
  salesCgstTax    Float
  salesSgstTax    Float
  salesIgstTax    Float
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  taxLedger       TaxLedgerAccount @relation(fields: [taxLedgerId], references: [id], onDelete: Cascade)

  @@map("tax_master")
}

model CategoryMaster {
  id            Int                 @id @default(autoincrement())
  categoryName  String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  partNumbers   PartNumberBase[]
  subCategories SubCategoryMaster[]

  @@map("category_master")
}

model SubCategoryMaster {
  id              Int              @id @default(autoincrement())
  categoryId      Int
  subCategoryName String
  prefixCode      String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  partNumbers     PartNumberBase[]
  category        CategoryMaster   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, subCategoryName])
  @@map("sub_category_master")
}

model PartNumberBase {
  id                   Int               @id @default(autoincrement())
  categoryId           Int
  subCategoryId        Int
  prefixCode           String
  digitCount           Int
  startingNumber       Int
  endingNumber         Int
  currentRunningNumber Int
  totalNumbers         Int
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  category             CategoryMaster    @relation(fields: [categoryId], references: [id])
  subCategory          SubCategoryMaster @relation(fields: [subCategoryId], references: [id])

  @@map("part_number_base")
}

model ItemMaster {
  id                     Int                     @id @default(autoincrement())
  groupId                Int?
  partNo                 String                  @unique
  outsourcePartNo        String?
  partName               String
  modelId                Int?
  brand                  String?
  description            String?
  size                   String?
  weight                 Float?
  unitId                 Int?
  hsnCode                String?
  purchaseRate           Float?
  marginPercent          Float?
  rate                   Float?
  currencyId             Int?
  taxId                  Int?
  subGroupId             Int?
  storeId                Int?
  rackNo                 String?
  location               String?
  itemTypeId             Int?
  qcTypeId               Int?
  materialGradeId        Int?
  materialTypeId         Int?
  rawMaterialId          Int?
  rmLength               String?
  rawMaterialWt          Float?
  fgMaterialWt           Float?
  reorderLevel           Float?
  minStock               Float?
  routeCardNo            String?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  imagePath              String?
  pdfPath                String?
  imageData              Bytes?
  imageMimeType          String?
  pdfData                Bytes?
  pdfMimeType            String?
  uploads                ItemMasterUpload[]
  purchaseDetails        PurchaseDetail[]
  purchaseRequestDetails PurchaseRequestDetail[]
  quotationDetails       QuotationDetail[]

  @@map("item_master")
}

model SupplierMaster {
  id             Int              @id @default(autoincrement())
  supplierType   String
  sCode          String           @unique
  supplierName   String
  address        String?
  address2       String?
  address3       String?
  address4       String?
  city           String?
  country        String?          @default("India")
  state          String?
  stateCode      String?
  pinCode        String?
  contactPerson  String?
  mobile         String?
  mobileCode     String?
  phone          String?
  phoneCode      String?
  email          String?
  website        String?
  gstNo          String?
  panNo          String?
  bankName       String?
  branchName     String?
  accountName    String?
  accountNumber  String?
  ifscCode       String?
  micrCode       String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchaseOrders PurchaseMaster[]

  @@map("supplier_master")
}

model ItemMasterUpload {
  id            Int        @id @default(autoincrement())
  itemId        Int
  imagePath     String?
  pdfPath       String?
  updatedBy     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  imageData     Bytes?
  imageMimeType String?
  pdfData       Bytes?
  pdfMimeType   String?
  item          ItemMaster @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_master_upload")
}

model CustomerMaster {
  id             Int               @id @default(autoincrement())
  customerType   String
  cCode          String            @unique
  customerName   String
  address        String?
  address2       String?
  address3       String?
  address4       String?
  city           String?
  country        String?           @default("India")
  state          String?
  stateCode      String?
  pinCode        String?
  contactPerson  String?
  mobile         String?
  mobileCode     String?
  phone          String?
  phoneCode      String?
  email          String?
  website        String?
  aadharNo       String?
  gstNo          String?
  panNo          String?
  bankName       String?
  branchName     String?
  accountName    String?
  accountNumber  String?
  ifscCode       String?
  micrCode       String?
  remarks        String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  imageData      Bytes?
  imageMimeType  String?
  imagePath      String?
  pdfData        Bytes?
  pdfMimeType    String?
  pdfPath        String?
  quotations     QuotationMaster[]
  vehicleMasters VehicleMaster[]

  @@map("customer_master")
}

model VehicleMaster {
  id             Int            @id @default(autoincrement())
  entryDate      DateTime       @default(now())
  customerId     Int
  vehicleCount   Int?           @default(1)
  address        String?
  vehicleNumber  String?
  modelName      String
  modelSubType   String?
  vehicleName    String
  serialNumber   String?
  bomType        String         @default("New")
  bomModelNumber String?
  remarks        String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customer       CustomerMaster @relation(fields: [customerId], references: [id])

  @@map("vehicle_master")
}

model QuotationMaster {
  id                Int               @id @default(autoincrement())
  quotationNo       String            @unique
  financialYear     String
  customerId        Int
  customerRef       String?
  currencyCode      String?           @default("INR")
  exchangeRate      Float             @default(1)
  modelRef          String?
  taxType           String?
  quotationDate     DateTime          @default(now())
  validUntil        DateTime?
  revisionNo        Int               @default(0)
  quotationType     String?
  discountType      String            @default("Dis_Per")
  showTotalsGrid    Boolean           @default(false)
  specialDiscount   Float             @default(0)
  freightAmount     Float             @default(0)
  taxPercent        Float             @default(18)
  packingForwarding Float             @default(0)
  subTotal          Float             @default(0)
  taxAmount         Float             @default(0)
  totalAmount       Float             @default(0)
  paymentTerms      String?
  status            String            @default("Draft")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  documentPath      String?
  documentData      Bytes?
  documentMimeType  String?
  details           QuotationDetail[]
  customer          CustomerMaster    @relation(fields: [customerId], references: [id])

  @@map("quotation_master")
}

model QuotationDetail {
  id          Int             @id @default(autoincrement())
  quotationId Int
  itemId      Int?
  partNo      String?
  itemName    String?
  description String?
  hsnCode     String?
  uom         String?
  qty         Float           @default(0)
  unitPrice   Float           @default(0)
  amount      Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  slNo        Int
  item        ItemMaster?     @relation(fields: [itemId], references: [id])
  quotation   QuotationMaster @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_detail")
}

model PurchaseRequest {
  id               Int                     @id @default(autoincrement())
  prNo             String                  @unique
  financialYear    String
  prDate           DateTime                @default(now())
  requiredDate     DateTime?
  department       String?
  requestingUser   String?
  team             String?
  requestingFor    String?
  remarks          String?
  status           String                  @default("Draft")
  poNo             String?
  poDate           DateTime?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  departmentId     Int?
  teamId           Int?
  requestingForId  Int?
  departmentRef    ReferenceMaster?        @relation("PRDepartmentRef", fields: [departmentId], references: [id])
  requestingForRef ReferenceMaster?        @relation("PRRequestingForRef", fields: [requestingForId], references: [id])
  teamRef          ReferenceMaster?        @relation("PRTeamRef", fields: [teamId], references: [id])
  details          PurchaseRequestDetail[]

  @@map("purchase_request")
}

model PurchaseRequestDetail {
  id            Int             @id @default(autoincrement())
  prId          Int
  slNo          Int
  itemId        Int?
  itemCode      String?
  itemName      String?
  specification String?
  jobNo         String?
  machineNo     String?
  uom           String?
  qty           Float           @default(0)
  eta           DateTime?
  purpose       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  item          ItemMaster?     @relation(fields: [itemId], references: [id])
  pr            PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@map("purchase_request_detail")
}

model PurchaseMaster {
  id              Int              @id @default(autoincrement())
  poNo            String           @unique
  financialYear   String
  poDate          DateTime         @default(now())
  etaDate         DateTime?
  poType          String           @default("Purchase Order")
  contactPerson   String?
  contactNumber   String?
  supplierAddress String?
  gstNo           String?
  supplierRefNo   String?
  discountType    String           @default("Dis_Per")
  freight         Float            @default(0)
  destination     String?
  paymentTerms    String?
  testReport      String?
  project         String?
  modeOfDespatch  String?
  deliveryPeriod  String?
  taxTerms        String?
  warrantyTerms   String?
  discountTerms   String?
  remarks         String?
  subTotal        Float            @default(0)
  cgstPer         Float            @default(0)
  cgstAmt         Float            @default(0)
  sgstPer         Float            @default(0)
  sgstAmt         Float            @default(0)
  igstPer         Float            @default(0)
  igstAmt         Float            @default(0)
  othersPer       Float            @default(0)
  othersAmt       Float            @default(0)
  totalAmount     Float            @default(0)
  status          String           @default("Draft")
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  details         PurchaseDetail[]
  supplier        SupplierMaster?  @relation(fields: [supplierRefNo], references: [sCode])

  @@map("purchase_master")
}

model PurchaseDetail {
  id             Int            @id @default(autoincrement())
  poId           Int
  slNo           Int
  itemId         Int?
  purchaseReqNo  String?
  supplierPartNo String?
  itemCode       String?
  itemName       String?
  description    String?
  hsnCode        String?
  uom            String?
  qty            Float          @default(0)
  unitPrice      Float          @default(0)
  discPer        Float          @default(0)
  discAmt        Float          @default(0)
  amount         Float          @default(0)
  gstPer         Float          @default(0)
  gstAmt         Float          @default(0)
  netAmt         Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  item           ItemMaster?    @relation(fields: [itemId], references: [id])
  po             PurchaseMaster @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@map("purchase_detail")
}

model GateMaster {
  id              Int          @id @default(autoincrement())
  gateEntryNo     String       @unique
  financialYear   String       @default("")
  gateEntryDate   DateTime     @default(now())
  poId            Int?
  poNo            String?
  prqNo           String?
  supplierName    String?
  supplierAddress String?
  gateNo          String?
  carrierName     String?
  vehicleNo       String?
  invoiceNo       String?
  invoiceDate     DateTime?
  remarks         String?
  status          String       @default("Open")
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  details         GateDetail[]

  @@map("gate_master")
}

