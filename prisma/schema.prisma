  workingStartDate DateTime?
  workingEndDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  jobCard          JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@map("job_card_line_item")
}

model ProcessMaster {
  id           Int      @id @default(autoincrement())
  partName     String   @map("pm_part_name")
  processName  String   @map("pm_process_name")
  processName1 String?  @map("pm_process_name1")
  processOrder String   @map("pm_process_order")
  teamId       String?  @map("team_id")
  machineCode  String?  @map("machine_code")
  machineName  String?  @map("machine_name")
  days         String?  @map("pm_days")
  hours        String?  @map("pm_hours")
  minutes      String?  @map("minutes")
  settingTime  String?  @map("setting_time")
  cycleTime    String?  @map("cycle_time")
  handlingTime String?  @map("handling_time")
  idleTime     String?  @map("idle_time")
  createdBy    String?  @default("Admin") @map("created_by")
  updatedBy    String?  @default("Admin") @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("process_master")
}

model MarketingLog {
