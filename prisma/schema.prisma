// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int             @id @default(autoincrement())
  name        String
  email       String          @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  credentials UserCredential?
}

model UserCredential {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  username  String   @unique
  password  String
  role      String   @default("user")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReferenceType {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String            @unique
  createdBy        String?
  createdAt        DateTime          @default(now())
  referenceMasters ReferenceMaster[]

  @@map("reference_type")
}

model ReferenceMaster {
  id              Int            @id @default(autoincrement())
  referenceType   String
  referenceTypeId Int?
  code            String
  description     String
  updatedBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refType         ReferenceType? @relation(fields: [referenceTypeId], references: [id], onDelete: SetNull)

  purchaseRequestsByDept         PurchaseRequest[] @relation("PRDepartmentRef")
  purchaseRequestsByTeam         PurchaseRequest[] @relation("PRTeamRef")
  purchaseRequestsByRequestingFor PurchaseRequest[] @relation("PRRequestingForRef")

  @@map("reference_master")
}

model TaxLedgerAccount {
  id         Int         @id @default(autoincrement())
  ledgerName String      @unique
  taxPercent Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  taxMasters TaxMaster[]

  @@map("tax_ledger_account")
}

model ItemGroupMaster {
  id        Int      @id @default(autoincrement())
  groupName String
  store     String
  prefix    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("item_group_master")
}

model Prefix {
  id         Int      @id @default(autoincrement())
  prefixCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("prefix")
}

model TaxMaster {
  id              Int              @id @default(autoincrement())
  taxLedgerId     Int
  taxPercent      Float
  cgstTax         Float
  sgstTax         Float
  igstTax         Float
  purchaseCgstTax Float
  purchaseSgstTax Float
  purchaseIgstTax Float
  salesCgstTax    Float
  salesSgstTax    Float
  salesIgstTax    Float
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  taxLedger       TaxLedgerAccount @relation(fields: [taxLedgerId], references: [id], onDelete: Cascade)

  @@map("tax_master")
}

model CategoryMaster {
  id            Int                 @id @default(autoincrement())
  categoryName  String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  subCategories SubCategoryMaster[]
  partNumbers   PartNumberBase[]

  @@map("category_master")
}

model SubCategoryMaster {
  id              Int              @id @default(autoincrement())
  categoryId      Int
  subCategoryName String
  prefixCode      String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        CategoryMaster   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  partNumbers     PartNumberBase[]

  @@unique([categoryId, subCategoryName])
  @@map("sub_category_master")
}

model PartNumberBase {
  id                   Int               @id @default(autoincrement())
  categoryId           Int
  subCategoryId        Int
  prefixCode           String
  digitCount           Int
  startingNumber       Int
  endingNumber         Int
  currentRunningNumber Int
  totalNumbers         Int
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  category             CategoryMaster    @relation(fields: [categoryId], references: [id])
  subCategory          SubCategoryMaster @relation(fields: [subCategoryId], references: [id])

  @@map("part_number_base")
}

model ItemMaster {
  id              Int                @id @default(autoincrement())
  groupId         Int?
  partNo          String             @unique
  outsourcePartNo String?
  partName        String
  modelId         Int?
  brand           String?
  description     String?
  size            String?
  weight          Float?
  unitId          Int?
  hsnCode         String?
  purchaseRate    Float?
  marginPercent   Float?
  rate            Float?
  currencyId      Int?
  taxId           Int?
  subGroupId      Int?
  storeId         Int?
  rackNo          String?
  location        String?
  itemTypeId      Int?
  qcTypeId        Int?
  materialGradeId Int?
  materialTypeId  Int?
  rawMaterialId   Int?
  rmLength        String?
  rawMaterialWt   Float?
  fgMaterialWt    Float?
  reorderLevel    Float?
  minStock        Float?
  imagePath       String?
  imageData       Bytes?
  imageMimeType   String?
  pdfPath         String?
  pdfData         Bytes?
  pdfMimeType     String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  uploads                ItemMasterUpload[]
  quotationDetails       QuotationDetail[]
  purchaseRequestDetails PurchaseRequestDetail[]
  purchaseDetails        PurchaseDetail[]

  @@map("item_master")
}

model SupplierMaster {
  id              Int              @id @default(autoincrement())
  supplierType    String
  sCode           String           @unique
  supplierName    String
  address         String?
  address2        String?
  address3        String?
  address4        String?
  city            String?
  country         String?          @default("India")
  state           String?
  stateCode       String?
  pinCode         String?
  contactPerson   String?
  mobile          String?
  phone           String?
  email           String?
  website         String?
  gstNo           String?
  panNo           String?
  bankName        String?
  branchName      String?
  accountName     String?
  accountNumber   String?
  ifscCode        String?
  micrCode        String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  purchaseOrders  PurchaseMaster[]

  @@map("supplier_master")
}

model ItemMasterUpload {
  id        Int        @id @default(autoincrement())
  itemId    Int
  item      ItemMaster @relation(fields: [itemId], references: [id], onDelete: Cascade)
  imagePath String?
  imageData Bytes?
  imageMimeType String?
  pdfPath   String?
  pdfData   Bytes?
  pdfMimeType String?
  updatedBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("item_master_upload")
}

model CustomerMaster {
  id            Int      @id @default(autoincrement())
  customerType  String
  cCode         String   @unique
  customerName  String
  address       String?
  address2      String?
  address3      String?
  address4      String?
  city          String?
  country       String?  @default("India")
  state         String?
  stateCode     String?
  pinCode       String?
  contactPerson String?
  mobile        String?
  phone         String?
  email         String?
  website       String?
  aadharNo      String?
  gstNo         String?
  panNo         String?
  bankName      String?
  branchName    String?
  accountName   String?
  accountNumber String?
  ifscCode      String?
  micrCode      String?
  remarks       String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  imagePath      String?
  imageData      Bytes?
  imageMimeType  String?
  pdfPath        String?
  pdfData        Bytes?
  pdfMimeType    String?
  vehicleMasters   VehicleMaster[]
  quotations       QuotationMaster[]

  @@map("customer_master")
}

model VehicleMaster {
  id             Int            @id @default(autoincrement())
  entryDate      DateTime       @default(now())
  customerId     Int
  vehicleCount   Int?           @default(1)
  address        String?
  vehicleNumber  String?
  modelName      String
  modelSubType   String?
  vehicleName    String
  serialNumber   String?
  bomType        String         @default("New")
  bomModelNumber String?
  remarks        String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customer       CustomerMaster @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@map("vehicle_master")
}

model QuotationMaster {
  id                Int               @id @default(autoincrement())
  quotationNo       String            @unique
  financialYear     String
  customerId        Int
  customerRef       String?
  currencyCode      String?           @default("INR")
  exchangeRate      Float             @default(1)
  modelRef          String?
  taxType           String?
  quotationDate     DateTime          @default(now())
  validUntil        DateTime?
  revisionNo        Int               @default(0)
  quotationType     String?
  discountType      String            @default("Dis_Per")
  showTotalsGrid    Boolean           @default(false)
  specialDiscount   Float             @default(0)
  freightAmount     Float             @default(0)
  taxPercent        Float             @default(18)
  packingForwarding Float             @default(0)
  subTotal          Float             @default(0)
  taxAmount         Float             @default(0)
  totalAmount       Float             @default(0)
  paymentTerms      String?
  documentPath      String?
  documentData      Bytes?
  documentMimeType  String?
  status            String            @default("Draft")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customer          CustomerMaster    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  details           QuotationDetail[]

  @@map("quotation_master")
}

model QuotationDetail {
  id          Int             @id @default(autoincrement())
  quotationId Int
  slNo        Int
  itemId      Int?
  partNo      String?
  itemName    String?
  description String?
  hsnCode     String?
  uom         String?
  qty         Float           @default(0)
  unitPrice   Float           @default(0)
  amount      Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  quotation   QuotationMaster @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item        ItemMaster?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("quotation_detail")
}

model PurchaseRequest {
  id             Int                     @id @default(autoincrement())
  prNo           String                  @unique
  financialYear  String
  prDate         DateTime                @default(now())
  requiredDate   DateTime?
  department     String?
  departmentId   Int?
  requestingUser String?
  team           String?
  teamId         Int?
  requestingFor   String?
  requestingForId Int?
  remarks         String?
  status          String                  @default("Draft")
  poNo            String?
  poDate          DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  details             PurchaseRequestDetail[]
  departmentRef       ReferenceMaster?        @relation("PRDepartmentRef", fields: [departmentId], references: [id], onDelete: SetNull)
  teamRef             ReferenceMaster?        @relation("PRTeamRef", fields: [teamId], references: [id], onDelete: SetNull)
  requestingForRef    ReferenceMaster?        @relation("PRRequestingForRef", fields: [requestingForId], references: [id], onDelete: SetNull)

  @@map("purchase_request")
}

model PurchaseRequestDetail {
  id            Int             @id @default(autoincrement())
  prId          Int
  slNo          Int
  itemId        Int?
  itemCode      String?
  itemName      String?
  specification String?
  jobNo         String?
  machineNo     String?
  uom           String?
  qty           Float           @default(0)
  eta           DateTime?
  purpose       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  pr            PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  item          ItemMaster?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("purchase_request_detail")
}

model PurchaseMaster {
  id              Int             @id @default(autoincrement())
  poNo            String          @unique
  financialYear   String
  poDate          DateTime        @default(now())
  etaDate         DateTime?
  poType          String          @default("Purchase Order")

  contactPerson   String?
  contactNumber   String?
  supplierAddress String?
  gstNo           String?
  supplierRefNo   String?
  discountType    String          @default("Dis_Per")
  freight         Float           @default(0)
  destination     String?
  paymentTerms    String?
  testReport      String?
  project         String?
  modeOfDespatch  String?
  deliveryPeriod  String?
  taxTerms        String?
  warrantyTerms   String?
  discountTerms   String?
  remarks         String?
  subTotal        Float           @default(0)
  cgstPer         Float           @default(0)
  cgstAmt         Float           @default(0)
  sgstPer         Float           @default(0)
  sgstAmt         Float           @default(0)
  igstPer         Float           @default(0)
  igstAmt         Float           @default(0)
  othersPer       Float           @default(0)
  othersAmt       Float           @default(0)
  totalAmount     Float           @default(0)
  status          String          @default("Draft")
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supplier        SupplierMaster? @relation(fields: [supplierRefNo], references: [sCode], onDelete: SetNull)
  details         PurchaseDetail[]

  @@map("purchase_master")
}

model PurchaseDetail {
  id             Int            @id @default(autoincrement())
  poId           Int
  slNo           Int
  itemId         Int?
  purchaseReqNo  String?
  supplierPartNo String?
  itemCode       String?
  itemName       String?
  description    String?
  hsnCode        String?
  uom            String?
  qty            Float          @default(0)
  unitPrice      Float          @default(0)
  discPer        Float          @default(0)
  discAmt        Float          @default(0)
  amount         Float          @default(0)
  gstPer         Float          @default(0)
  gstAmt         Float          @default(0)
  netAmt         Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  po             PurchaseMaster @relation(fields: [poId], references: [id], onDelete: Cascade)
  item           ItemMaster?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("purchase_detail")
}

model GateMaster {
  id              Int          @id @default(autoincrement())
  gateEntryNo     String       @unique
  financialYear   String       @default("")
  gateEntryDate   DateTime     @default(now())
  poId            Int?
  poNo            String?
  prqNo           String?
  supplierName    String?
  supplierAddress String?
  gateNo          String?
  carrierName     String?
  vehicleNo       String?
  invoiceNo       String?
  invoiceDate     DateTime?
  remarks         String?
  status          String       @default("Open")
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  details         GateDetail[]

  @@map("gate_master")
}

model EmployeeMaster {
  id             Int       @id @default(autoincrement())
  empCode        String    @unique
  empName        String
  address        String?
  contactNo      String?
  adharNo        String?
  joinDate       DateTime?
  relevingDate   DateTime?
  department     String?
  designation    String?
  contractPerson String?
  companyName    String?
  team           String?
  emailId        String?
  repPerson      String?
  status         String    @default("Active")
  createdBy      String?
  updatedBy      String?
  deletedBy      String?
  deletedDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("employee_master")
}

model CompanyMaster {
  id               Int      @id @default(autoincrement())
  companyCode      String   @unique
  companyName      String
  companyType      String?
  doorNumber       String?
  street           String?
  place            String?
  post             String?
  city             String?
  taluk            String?
  district         String?
  districtCode     String?
  state            String?
  stateCode        String?
  country          String?  @default("India")
  pinCode          String?
  address          String?
  gstin            String?
  panNo            String?
  companyPhone     String?
  companyEmail     String?
  companyWebsite   String?
  marketingPhone   String?
  marketingEmail   String?
  marketingWebsite String?
  purchasePhone    String?
  purchaseEmail    String?
  purchaseWebsite  String?
  salesPhone       String?
  salesEmail       String?
  salesWebsite     String?
  servicePhone     String?
  serviceEmail     String?
  serviceWebsite   String?
  bankName         String?
  bankBranch       String?
  bankAccountType  String?
  bankAccountName  String?
  bankAccountNumber String?
  bankIfscCode     String?
  bankMicrCode     String?
  bankDistrict     String?
  bankState        String?
  bankPinCode      String?
  bankCountry      String?
  bankAddress      String?
  logoPath         String?
  logoData         Bytes?
  logoMimeType     String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("company_master")
}

model GateDetail {
  id             Int        @id @default(autoincrement())
  gateId         Int
  slNo           Int
  poNo           String?
  itemCode       String?
  itemName       String?
  supplierPartNo String?
  description    String?
  hsnCode        String?
  unit           String?
  qty            Float      @default(0)
  recQty         Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  gate           GateMaster @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@map("gate_detail")
}

model ContractorMaster {
  id             Int      @id @default(autoincrement())
  contractCode   String   @unique
  contractName   String
  address        String?
  phone          String?
  email          String?
  status         String   @default("Active")
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("contractor_master")
}

model GRNMaster {
  id             Int         @id @default(autoincrement())
  grnNo          String      @unique
  financialYear  String      @default("")
  grnDate        DateTime    @default(now())
  grnType        String?
  gateEntryNo    String?
  supplierName   String?
  contactPerson  String?
  contactNo      String?
  purchaseLedger String?
  purchaseType   String?
  currency       String?
  currencyType   String?
  poNo           String?
  poDate         DateTime?
  taxType        String?
  exchangeRate   Float       @default(0)
  invoiceNo      String?
  invoiceDate    DateTime?
  qcType         String?
  discountType   String      @default("Dis_Per")
  remarks        String?
  currencyTotal  Float       @default(0)
  roundOff       Float       @default(0)
  freightLedger  String?
  tcsLedger      String?
  subTotal       Float       @default(0)
  totalAmount    Float       @default(0)
  status         String      @default("Open")
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  details        GRNDetail[]

  @@map("grn_master")
}

model GRNDetail {
  id             Int       @id @default(autoincrement())
  grnId          Int
  slNo           Int
  itemCode       String?
  itemName       String?
  supplierPartNo String?
  description    String?
  hsnCode        String?
  unit           String?
  stockQty       Float     @default(0)
  orderQty       Float     @default(0)
  qty            Float     @default(0)
  unitPrice      Float     @default(0)
  total          Float     @default(0)
  discPer        Float     @default(0)
  discAmt        Float     @default(0)
  finalPrice     Float     @default(0)
  taxPer         Float     @default(0)
  netAmt         Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  grn            GRNMaster @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@map("grn_detail")
}

model MachineMaster {
  id                 Int       @id @default(autoincrement())
  machineCode        String    @unique
  machineName        String
  serialNo           String?
  machineCategoryId  String?
  workHoursPerDay    String?
  model              String?
  country            String?
  currency           String?
  vendorId           String?
  installationPlace  String?
  remarks            String?
  yearOfFG           DateTime?
  dateOfPurchase     DateTime?
  dateOfInstallation DateTime?
  warantyExpDate     DateTime?
  amcExpDate         DateTime?
  status             String    @default("Active")
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("machine_master")
}

model VehicleServiceMaster {
  id             Int      @id @default(autoincrement())
  vehicleTypeId  String
  serviceName    String
  labourCharge   Float    @default(0)
  materialCharge Float    @default(0)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("vehicle_service_master")
}

model MaterialRequest {
  id             Int                     @id @default(autoincrement())
  mrNo           String                  @unique
  financialYear  String
  tempRequestNo  String?
  departmentTo   String?
  requestingUser String?
  team           String?
  requestingFor  String?
  requestDate    DateTime                @default(now())
  requiredDate   DateTime?
  requiredDays   String?
  storeName      String?
  bomPartName    String?
  remarks        String?
  status         String                  @default("Draft")
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  details        MaterialRequestDetail[]

  @@map("material_request")
}

model MaterialRequestDetail {
  id            Int             @id @default(autoincrement())
  mrId          Int
  slNo          Int
  modelName     String?
  itemCode      String?
  itemName      String?
  requestedQty  Float           @default(0)
  materialGrade String?
  unit          String?
  remarks       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  mr            MaterialRequest @relation(fields: [mrId], references: [id], onDelete: Cascade)

  @@map("material_request_detail")
}
