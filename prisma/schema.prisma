  customerCode         String?
  complainantName      String?
  modelNo              String?
  siteAddress          String?
  whatsappLocation     String?
  openingComplaint     String?
  serialNo             String?
  designation          String?
  mobileNo             String?
  alternateNo          String?
  emailId              String?
  complaintType        String?
  serviceType          String?
  workCompleteDate     String?
  complaintClosedDate  String?
  natureOfComplaint    String?
  actionThrough        String?
  attenderName         String?
  attenDate            String?
  finalDate            String?
